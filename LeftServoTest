package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.CRServo;

@TeleOp(name = "LeftServoTest")
public class SideServosTeleOp extends LinearOpMode {

    private CRServo left_servo;

    @Override
    public void runOpMode() {

        left_servo = hardwareMap.get(CRServo.class, "left_servo");

        left_servo.setPower(0);

        telemetry.addLine("Side Servos Ready");
        telemetry.update();

        waitForStart();

        while (opModeIsActive()) {

            // Move the left bumpet to control the left servo
            if (gamepad2.left_bumper) {
                left_servo.setPower(0.7);
            } else {
                left_servo.setPower(0);
            }

            idle();
        }

        // Stop both servos when OpMode ends
        left_servo.setPower(0);
    }
}
