package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.CRServo;

@TeleOp(name = "Shooter2")
public class Shooter2 extends LinearOpMode {

    private DcMotor shooter;
    private DcMotor intake;
    private CRServo windmill;

    private static final double SHOOTER_POWER = 0.52;
    private static final double INTAKE_POWER = 0.9;
    private static final double WINDMILL_POWER = 0.7;

    private static final long WINDMILL_DELAY = 1500;

    @Override
    public void runOpMode() {

        RobotEncoderRevPID.bindFromLinearOpMode(this);
        RobotEncoderRevPID.initRobot();

        shooter = hardwareMap.get(DcMotor.class, "shooter");
        intake = hardwareMap.get(DcMotor.class, "intake");
        windmill = hardwareMap.get(CRServo.class, "windmill");

        shooter.setDirection(DcMotor.Direction.FORWARD);
        intake.setDirection(DcMotor.Direction.FORWARD);
        windmill.setDirection(CRServo.Direction.REVERSE);

        shooter.setPower(0);
        intake.setPower(0);
        windmill.setPower(0);

        telemetry.addLine("Shooter Ready");
        telemetry.addLine("Intake Ready");
        telemetry.addLine("Windmill Ready");
        telemetry.addLine("Mecanum Drive Ready");
        telemetry.update();

        waitForStart();

        long shooterStartTime = 0;

        while (opModeIsActive()) {

            double forward = -gamepad1.left_stick_y;
            double strafe = -gamepad1.left_stick_x;
            double turn = gamepad1.right_stick_x;

            RobotEncoderRevPID.driveArcade(forward, strafe, turn);

            if (gamepad1.left_bumper) {

                shooter.setPower(SHOOTER_POWER);

                if (shooterStartTime == 0) {
                    shooterStartTime = System.currentTimeMillis();
                }

                if (System.currentTimeMillis() - shooterStartTime
                        >= WINDMILL_DELAY) {
                    windmill.setPower(WINDMILL_POWER);
                } else {
                    windmill.setPower(0);
                }

            } else {
                shooter.setPower(0);
                windmill.setPower(0);
                shooterStartTime = 0;
            }

            if (gamepad1.right_bumper) {
                intake.setPower(INTAKE_POWER);
            } else {
                intake.setPower(0);
            }

            if (gamepad1.a) {
                windmill.setPower(WINDMILL_POWER);
            }

            telemetry.addData("Shooter", gamepad1.left_bumper ? "ON" : "OFF");
            telemetry.addData("Intake", gamepad1.right_bumper ? "ON" : "OFF");
            telemetry.addData("Windmill", windmill.getPower());
            telemetry.update();
        }

        RobotEncoderRevPID.stopAll();
        shooter.setPower(0);
        intake.setPower(0);
        windmill.setPower(0);
    }
}
